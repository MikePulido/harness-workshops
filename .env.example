# Copy to .env at the repository root and fill in. harness-workshops/install.py
# reads it; nothing else does. Flags and environment variables override it
# (see the docstring at the top of harness-workshops/install.py).

# ---- Harness target ----------------------------------------------------------
# Account and org that hold the event projects. The org is the identifier,
# which is lowercase (for example event_hws279), not the display name.
WORKSHOP_ACCOUNT_ID=XXXXXXXXXXXXXXXXXXXXXX
WORKSHOP_ORG_ID=event_hwsNNN

# Defaults for --project and --token. Each event project has its own user
# and personal access token; pass --project/--token per run, or edit these
# before each run. The token needs IaCM, Code, Pipeline, Template, STO,
# Environment and Variable rights in that project.
WORKSHOP_PROJECT_ID=abc1hwsNNN
WORKSHOP_API_KEY=pat.XXXXXXXXXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXX

# Email the token belongs to. Used as the git user for pushes to Harness Code.
# Optional: defaults to <project>@harnessevents.com, which is right for
# event-provisioned projects. Set it when the key belongs to someone else
# (for example an org-scoped token).
#WORKSHOP_GIT_USERNAME=facilitator@example.com

# ---- Model -------------------------------------------------------------------
# Stored as project secret anthropic_api_key behind connector anthropic_api
# (claude-sonnet-4-6). Both Worker Agents use it.
anthropic_api_key=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ---- Cloud credential ----------------------------------------------------------
# IaCM requires a provider connector on every workspace; the drift workshop
# never calls AWS, so any valid key pair works. Stored as secret aws_secret_key
# behind connector aws_creds.
aws-access-key=AKIAXXXXXXXXXXXXXXXX
aws-secret-key=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#AWS_REGION=us-east-2

# ---- Optional --------------------------------------------------------------------
# Only for a non-default Harness endpoint.
#HARNESS_API_URL=https://app.harness.io
